{
  "expo": {
    "name": "GymFlow",
    "slug": "gymflow-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gymflowmobile",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIStatusBarStyle": "UIStatusBarStyleLightContent"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4F7DFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false
    },
    "androidStatusBar": {
      "backgroundColor": "#0B1328",
      "barStyle": "light-content"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#0B1328",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#0B1328"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "GymFlow necesita acceso a tus fotos para personalizar perfiles, clases, rutinas y el gimnasio.",
          "cameraPermission": "GymFlow necesita acceso a la cámara para fotos de perfil y multimedia de ejercicios."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "GymFlow necesita acceso a la cámara para escanear invitaciones y hacer fotos de perfil.",
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
